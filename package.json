{
	"name": "arcane-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#velite/*": "./.velite/*"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"velite": "velite",
		"dev": "velite --watch & vp dev --port 3001",
		"prebuild": "pnpm velite",
		"build": "vp build && pagefind --site build",
		"prepare": "vp config",
		"check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json",
		"format": "vp fmt",
		"lint": "vp lint && eslint src"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/enhanced-img": "1.0.0",
