		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.536",
		"@internationalized/date": "^3.12.4",
		"@shadcn/lint": "^0.2.0",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@typescript-eslint/parser": "^8.71.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.11.0",
		"isomorphic-dompurify": "^4.4.0",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.5.2",
		"rolldown": "^1.2.12",
		"runed": "^0.37.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
