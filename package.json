{
	"name": "arcane-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#velite/*": "./.velite/*"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"velite": "velite",
		"dev": "velite --watch & vp dev --port 3001",
		"prebuild": "pnpm velite",
		"build": "vp build",
		"prepare": "vp config",
		"check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt",
		"lint": "vp lint"
	},
