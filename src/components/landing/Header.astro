---
import GithubStats from '../GithubStats.astro';
import Logo from '../../lib/components/logo.svelte';
import { mainNavItems } from '../../lib/config/docs';
import ThemeToggle from './ThemeToggle.astro';

const link =
	'inline-flex h-9 items-center gap-2 rounded-full px-3.5 text-sm font-medium text-gray-2 no-underline transition-colors hover:bg-surface-muted hover:text-fg';
---

<header class="sticky top-0 z-40 border-b border-hairline bg-[color-mix(in_oklch,var(--sl-color-black),transparent_20%)] backdrop-blur-xl">
	<div class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between gap-4 px-4 lg:px-6">
		<a
			href="/"
			class="inline-flex items-center gap-2.5 text-fg no-underline"
			aria-label="Arcane home"
		>
			<Logo class="size-6" />
			<span class="text-[1.0625rem] font-semibold tracking-tight">Arcane</span>
		</a>
		<nav class="flex items-center gap-1" aria-label="Site">
			{mainNavItems.map((l, i) => (
				<a href={l.href} class:list={[link, i > 0 && 'max-md:hidden']}>
					{l.label}
				</a>
			))}
			<GithubStats showVersion={false} />
			<ThemeToggle />
		</nav>
	</div>
</header>
