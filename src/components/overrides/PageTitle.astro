---
const { entry } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const PAGE_TITLE_ID = '_top';
const showLead = entry.data.template !== 'splash';
---

<div class="page-title">
	<h1 id={PAGE_TITLE_ID}>{title}</h1>
	{showLead && description && <p class="page-lead">{description}</p>}
</div>

<style>
	.page-title {
		margin-top: 1rem;
	}
	h1 {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.page-lead {
		margin: 0.75rem 0 0;
		max-width: 42rem;
		font-size: 1rem;
		line-height: 1.625;
		color: var(--sl-color-gray-3);
		text-wrap: balance;
	}
</style>
