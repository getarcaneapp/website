---
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { DEMO_URL, mainNavItems } from '../../lib/config/docs';
---

<nav class="mobile-sections" aria-label="Sections">
	{mainNavItems.map((item) => (
		<a href={item.href}>{item.label}</a>
	))}
	<a href={DEMO_URL} target="_blank" rel="noopener" class="demo">
		Try the Demo
	</a>
</nav>
<Default />

<style>
	.mobile-sections {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-block: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.mobile-sections a {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding: 0 0.875rem;
		border-radius: 999px;
		background-color: var(--surface-muted);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.mobile-sections a.demo {
		background-color: var(--sl-color-accent);
		color: oklch(0.985 0 0);
	}
</style>
