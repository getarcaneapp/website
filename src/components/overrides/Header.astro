---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import { mainNavItems } from '../../lib/config/docs';
import SocialIcons from './SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="header-nav print:hidden" aria-label="Sections">
		{mainNavItems.map((l) => (
			<a class="header-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
				{l.label}
			</a>
		))}
	</nav>
	<div class="header-end sl-flex print:hidden">
		<Search />
		<div class="right-group">
			<SocialIcons />
			<ThemeSelect />
		</div>
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		gap: var(--sl-nav-gap);
		height: 100%;
	}
	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) .title-wrapper {
			flex-shrink: 0;
			width: calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x) - var(--sl-nav-gap) + 0.25rem);
		}
	}
	.header-nav {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}
	@media (min-width: 72rem) {
		.header-nav {
			display: flex;
		}
	}
	.header-link {
		display: inline-flex;
		align-items: center;
		height: 2.25rem;
		padding: 0 0.875rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.header-link:hover {
		background-color: var(--surface-muted);
		color: var(--sl-color-white);
	}
	.header-link[aria-current='page'] {
		background-color: color-mix(in oklch, var(--sl-color-accent), transparent 88%);
		color: var(--sl-color-accent-high);
	}
	:global([data-theme='light']) .header-link[aria-current='page'] {
		color: var(--sl-color-accent);
	}
	.header-end {
		flex: 1;
		justify-content: flex-end;
		align-items: center;
		gap: 1rem;
		min-width: 0;
	}
	.right-group {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}
	@media (min-width: 50rem) {
		.right-group {
			display: flex;
		}
	}
	.header-end :global(site-search) {
		flex: 0 1 18rem;
	}
</style>
