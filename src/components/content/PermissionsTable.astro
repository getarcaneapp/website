---
import { permissionCount, permissionResources } from '../../lib/config/pages/permissions';
import EndpointCode from './EndpointCode.astro';
import PermissionCode from './PermissionCode.astro';
import TableFilter from './TableFilter.astro';
---

<TableFilter
	label="Search permissions"
	noun="permissions"
	total={permissionCount}
	empty="No permissions match. Try a resource name like containers."
>
	<table>
		<thead>
			<tr>
				<th>Permission</th>
				<th>Details</th>
			</tr>
		</thead>
		<tbody>
			{permissionResources.flatMap((resource) =>
				resource.actions.map((action) => (
					<tr
						data-search={`${action.permission} ${resource.label} ${action.description} ${action.endpoints.map((endpoint) => endpoint.path).join(' ')}`.toLowerCase()}
					>
						<td>
							<PermissionCode permission={action.permission} />
						</td>
						<td>
							<div class="env-details">
								<p>{action.description}</p>
								<div class="env-meta">
									<span class="env-label">Scope</span>
									<span>{resource.scope === 'global' ? 'Global' : 'Environment'}</span>
									{action.requires.length > 0 && (
										<>
											<span class="env-label">Requires</span>
											<span class="env-badges">
												{action.requires.map((permission) => (
													<PermissionCode permission={permission} />
												))}
											</span>
										</>
									)}
									{action.endpoints.length > 0 && (
										<>
											<span class="env-label">Endpoints</span>
											<details class="endpoints">
												<summary>
													{action.endpoints.length}{' '}
													{action.endpoints.length === 1 ? 'endpoint' : 'endpoints'}
												</summary>
												<ul>
													{action.endpoints.map((endpoint) => (
														<li>
															<EndpointCode method={endpoint.method} path={endpoint.path} />
															{endpoint.summary && (
																<span class="endpoint-summary">{endpoint.summary}</span>
															)}
														</li>
													))}
												</ul>
											</details>
										</>
									)}
								</div>
							</div>
						</td>
					</tr>
				))
			)}
		</tbody>
	</table>
</TableFilter>

<style>
.endpoints summary {
	display: inline-flex;
	align-items: center;
	gap: 0.375rem;
	padding: 0.2rem 0.6rem;
	border: 1px solid var(--surface-border);
	border-radius: 999px;
	background-color: var(--surface-muted);
	color: var(--sl-color-white);
	font-size: var(--sl-text-xs);
	cursor: pointer;
	list-style: none;
	user-select: none;
}
.endpoints summary::-webkit-details-marker {
	display: none;
}
.endpoints summary::before {
	content: "";
	width: 0.375rem;
	height: 0.375rem;
	border-right: 1.5px solid currentColor;
	border-bottom: 1.5px solid currentColor;
	transform: rotate(-45deg);
	transition: transform 0.15s ease;
}
.endpoints[open] summary::before {
	transform: rotate(45deg);
}
.endpoints summary:hover {
	border-color: var(--sl-color-accent);
	color: var(--sl-color-accent-high);
}
.endpoints summary:focus-visible {
	outline: 2px solid color-mix(in oklch, var(--sl-color-accent), transparent 50%);
	outline-offset: 1px;
}
.endpoints ul {
	display: grid;
	gap: 0.5rem;
	margin: 0.625rem 0 0;
	padding: 0;
	list-style: none;
}
.endpoints li {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.25rem 0.75rem;
	margin: 0;
}
.endpoint-summary {
	color: var(--sl-color-gray-3);
	font-size: var(--sl-text-xs);
}
</style>
