---
import { envSettingsOverrides } from '../../lib/config/pages/runtime-config';

const rowId = (env: string) => `setting-${env.toLowerCase()}`;
---

<div class="filter-table not-content" data-filter-target="env">
	<table>
		<thead>
			<tr>
				<th>Variable</th>
				<th>Details</th>
			</tr>
		</thead>
		<tbody>
			{envSettingsOverrides.map((item) => (
				<tr
					id={rowId(item.env)}
					data-search={`${item.env} ${item.settingKey} ${item.description}`.toLowerCase()}
				>
					<td>
						<a class="env-anchor" href={`#${rowId(item.env)}`}>
							<code>{item.env}</code>
						</a>
					</td>
					<td>
						<div class="env-details">
							<p>{item.description}</p>
							<div class="env-meta">
								<span class="env-label">Setting</span>
								<code>{item.settingKey}</code>
							</div>
							{item.requires && (
								<p class="env-note">
									<span class="env-label">Requires:</span> {item.requires}
								</p>
							)}
							{item.note && <p class="env-note">{item.note}</p>}
							{(item.sensitive || item.deprecated) && (
								<div class="env-badges">
									{item.sensitive && <span class="env-badge sensitive">Sensitive</span>}
									{item.deprecated && <span class="env-badge deprecated">Deprecated</span>}
								</div>
							)}
						</div>
					</td>
				</tr>
			))}
		</tbody>
	</table>
</div>
