---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
	loading?: 'lazy' | 'eager';
	decoding?: 'async' | 'sync' | 'auto';
	class?: string;
}

const { caption, name, alt, loading = 'lazy', decoding = 'async', class: className } = Astro.props;
const label = alt || caption || 'Screenshot';

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/screenshots/*.{png,jpg}',
	{ eager: true }
);
const pick = (theme: 'light' | 'dark') => {
	const image =
		screenshots[`../../assets/screenshots/${name}-${theme}.png`] ??
		screenshots[`../../assets/screenshots/${name}-${theme}.jpg`];
	if (!image)
		throw new Error(
			`Missing screenshot src/assets/screenshots/${name}-${theme}.png or .jpg; run pnpm screenshots`
		);
	return image.default;
};
const light = pick('light');
const dark = pick('dark');
const [lightFull, darkFull] = await Promise.all([
	getImage({ src: light, format: 'webp' }),
	getImage({ src: dark, format: 'webp' })
]);
---

<figure class="screenshot not-content" data-screenshot>
	<button
		type="button"
		class="screenshot-trigger"
		aria-label={`Open ${label} in a larger view`}
		data-screenshot-open
	>
		<span class="screenshot-frame">
			<Image
				src={light}
				alt={alt}
				widths={[768, 1536]}
				sizes="(min-width: 50rem) 48rem, 100vw"
				loading={loading}
				decoding={decoding}
				class:list={['light-only', className]}
			/>
			<Image
				src={dark}
				alt={alt}
				widths={[768, 1536]}
				sizes="(min-width: 50rem) 48rem, 100vw"
				loading={loading}
				decoding={decoding}
				class:list={['dark-only', className]}
			/>
		</span>
	</button>
	{caption && <figcaption>{caption}</figcaption>}
	<dialog class="screenshot-dialog" aria-label={label} data-screenshot-dialog>
		<button type="button" class="screenshot-close" aria-label="Close" data-screenshot-close>
			×
		</button>
		<img
			src={lightFull.src}
			alt={alt}
			width={lightFull.attributes.width}
			height={lightFull.attributes.height}
			class="light-only"
			loading="lazy"
			decoding="async"
		/>
		<img
			src={darkFull.src}
			alt={alt}
			width={darkFull.attributes.width}
			height={darkFull.attributes.height}
			class="dark-only"
			loading="lazy"
			decoding="async"
		/>
		{caption && <p>{caption}</p>}
	</dialog>
</figure>

<script>
	document.querySelectorAll<HTMLElement>('[data-screenshot]').forEach((figure) => {
		const dialog = figure.querySelector<HTMLDialogElement>('[data-screenshot-dialog]');
		if (!dialog) return;
		figure
			.querySelector('[data-screenshot-open]')
			?.addEventListener('click', () => dialog.showModal());
		figure
			.querySelector('[data-screenshot-close]')
			?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.screenshot {
		margin-block: 2rem;
	}
	:global([data-theme='dark']) .light-only,
	:global([data-theme='light']) .dark-only {
		display: none !important;
	}
	.screenshot-trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		text-align: start;
	}
	.screenshot-frame {
		display: block;
		padding: 0.5rem;
		border: 1px solid var(--surface-border);
		border-radius: 0.875rem;
		background-color: var(--surface-muted);
		overflow: hidden;
		transition:
			border-color 0.15s ease,
			box-shadow 0.2s ease;
	}
	.screenshot-trigger:hover .screenshot-frame {
		border-color: color-mix(in oklch, var(--sl-color-accent), transparent 60%);
		box-shadow: var(--surface-shadow-lg);
	}
	.screenshot-frame img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--surface-border);
		border-radius: 0.5rem;
	}
	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.screenshot-dialog {
		width: 96vw;
		max-width: 96vw;
		max-height: 94vh;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}
	.screenshot-dialog::backdrop {
		background-color: oklch(0 0 0 / 0.8);
		backdrop-filter: blur(4px);
	}
	.screenshot-dialog[open] {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}
	.screenshot-dialog img {
		width: auto;
		max-width: 100%;
		max-height: 86vh;
		object-fit: contain;
		border-radius: 1.25rem;
		box-shadow: 0 25px 50px -12px oklch(0 0 0 / 0.5);
	}
	.screenshot-dialog p {
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: oklch(0.9 0 0);
	}
	.screenshot-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 999px;
		background-color: oklch(1 0 0 / 0.12);
		color: oklch(0.98 0 0);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}
	.screenshot-close:hover {
		background-color: oklch(1 0 0 / 0.2);
	}
</style>
