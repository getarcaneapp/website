---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
	loading?: 'lazy' | 'eager';
	decoding?: 'async' | 'sync' | 'auto';
	class?: string;
}

const { caption, name, alt, loading = 'lazy', decoding = 'async', class: className } = Astro.props;
const label = alt || caption || 'Screenshot';

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/screenshots/*.{png,jpg}',
	{ eager: true }
);
const pick = (theme: 'light' | 'dark') => {
	const image =
		screenshots[`../../assets/screenshots/${name}-${theme}.png`] ??
		screenshots[`../../assets/screenshots/${name}-${theme}.jpg`];
	if (!image)
		throw new Error(
			`Missing screenshot src/assets/screenshots/${name}-${theme}.png or .jpg; run pnpm screenshots`
		);
	return image.default;
};
const light = pick('light');
const dark = pick('dark');
const [lightFull, darkFull] = await Promise.all([
	getImage({ src: light, format: 'webp' }),
	getImage({ src: dark, format: 'webp' })
]);
---

<figure class="screenshot not-content" data-screenshot>
	<button
		type="button"
		class="screenshot-trigger"
		aria-label={`Open ${label} in a larger view`}
		data-screenshot-open
	>
		<span class="screenshot-frame">
			<Image
				src={light}
				alt={alt}
				widths={[768, 1536]}
				sizes="(min-width: 50rem) 48rem, 100vw"
				loading={loading}
				decoding={decoding}
				class:list={['light-only', className]}
			/>
			<Image
				src={dark}
				alt={alt}
				widths={[768, 1536]}
				sizes="(min-width: 50rem) 48rem, 100vw"
				loading={loading}
				decoding={decoding}
				class:list={['dark-only', className]}
			/>
		</span>
	</button>
	{caption && <figcaption>{caption}</figcaption>}
	<dialog class="screenshot-dialog" aria-label={label} data-screenshot-dialog>
		<div class="screenshot-dialog-bar">
			<a href={light.src} class="screenshot-full light-only" target="_blank" rel="noopener">
				Open full-size image
			</a>
			<a href={dark.src} class="screenshot-full dark-only" target="_blank" rel="noopener">
				Open full-size image
			</a>
			<button
				type="button"
				class="screenshot-close"
				aria-label="Close larger view"
				autofocus
				data-screenshot-close
			>
				×
			</button>
		</div>
		<!-- Screenshots are captured at 2x. On phones the image renders at its 1x size inside a
		     scroll area, so readers can pan and pinch-zoom instead of squinting at a letterbox. -->
		<div
			class="screenshot-dialog-body"
			data-screenshot-scroll
			style={`--shot-width: ${Math.round(Number(lightFull.attributes.width ?? light.width) / 2)}px`}
		>
			<img
				src={lightFull.src}
				alt={alt}
				width={lightFull.attributes.width}
				height={lightFull.attributes.height}
				class="light-only"
				loading="lazy"
				decoding="async"
			>
			<img
				src={darkFull.src}
				alt={alt}
				width={darkFull.attributes.width}
				height={darkFull.attributes.height}
				class="dark-only"
				loading="lazy"
				decoding="async"
			>
			{caption && <p>{caption}</p>}
		</div>
	</dialog>
</figure>

<script>
document.querySelectorAll<HTMLElement>('[data-screenshot]').forEach((figure) => {
	const dialog = figure.querySelector<HTMLDialogElement>('[data-screenshot-dialog]');
	if (!dialog) return;
	figure
		.querySelector('[data-screenshot-open]')
		?.addEventListener('click', () => dialog.showModal());
	figure.querySelector('[data-screenshot-close]')?.addEventListener('click', () => dialog.close());
	const scroll = dialog.querySelector('[data-screenshot-scroll]');
	// Clicks on the empty area around the image close the view. Esc is handled by <dialog>.
	dialog.addEventListener('click', (event) => {
		if (event.target === dialog || event.target === scroll) dialog.close();
	});
});
</script>

<style>
.screenshot {
	margin-block: 2rem;
}
:global([data-theme="dark"]) .light-only,
:global([data-theme="light"]) .dark-only {
	display: none !important;
}
.screenshot-trigger {
	display: block;
	width: 100%;
	padding: 0;
	border: 0;
	border-radius: 0.5rem;
	background: none;
	cursor: zoom-in;
	text-align: start;
}
.screenshot-trigger:focus-visible {
	outline: 2px solid var(--focus-ring);
	outline-offset: 2px;
}
/* One 1px border and a small radius. No mat, no shadow (shadows are for overlays). */
.screenshot-frame {
	display: block;
	border: 1px solid var(--surface-border);
	border-radius: 0.5rem;
	overflow: hidden;
	transition: border-color 0.15s ease;
}
.screenshot-trigger:hover .screenshot-frame {
	border-color: var(--sl-color-gray-4);
}
.screenshot-frame img {
	display: block;
	width: 100%;
	height: auto;
}
figcaption {
	margin-top: 0.625rem;
	font-size: var(--sl-text-sm);
	color: var(--sl-color-gray-3);
}
.screenshot-dialog {
	width: 100vw;
	max-width: 100vw;
	height: 100dvh;
	max-height: 100dvh;
	margin: 0;
	padding: 0;
	border: 0;
	background: transparent;
	color: oklch(0.98 0 0);
	overflow: hidden;
}
.screenshot-dialog::backdrop {
	background-color: oklch(0 0 0 / 0.85);
	backdrop-filter: blur(4px);
}
.screenshot-dialog[open] {
	display: flex;
	flex-direction: column;
}
.screenshot-dialog-bar {
	display: flex;
	flex-shrink: 0;
	align-items: center;
	justify-content: flex-end;
	gap: 1rem;
	padding: 0.75rem 1rem;
}
.screenshot-full {
	color: oklch(0.98 0 0);
	font-size: var(--sl-text-sm);
	font-weight: 500;
	text-decoration: underline;
	text-underline-offset: 0.25em;
}
.screenshot-full:focus-visible {
	outline: 2px solid oklch(0.98 0 0);
	outline-offset: 2px;
}
.screenshot-dialog-body {
	display: flex;
	flex: 1;
	flex-direction: column;
	align-items: center;
	gap: 1rem;
	min-height: 0;
	padding: 0 1rem 1rem;
	overflow: auto;
	overscroll-behavior: contain;
	touch-action: pan-x pan-y pinch-zoom;
}
.screenshot-dialog-body:focus-visible {
	outline: 2px solid oklch(0.98 0 0);
	outline-offset: -2px;
}
.screenshot-dialog img {
	width: auto;
	max-width: 100%;
	height: auto;
	max-height: calc(100dvh - 6rem);
	object-fit: contain;
	border-radius: 0.5rem;
	box-shadow: 0 25px 50px -12px oklch(0 0 0 / 0.5);
}
/* Phones: show the image at its 1x size and let the reader pan. Keeps the aspect ratio. */
@media (max-width: 50rem) {
	.screenshot-dialog-body {
		align-items: flex-start;
	}
	.screenshot-dialog img {
		flex-shrink: 0;
		width: var(--shot-width);
		max-width: none;
		max-height: none;
	}
}
.screenshot-dialog p {
	margin: 0;
	align-self: stretch;
	text-align: center;
	font-size: var(--sl-text-sm);
	color: oklch(0.9 0 0);
}
.screenshot-close {
	display: grid;
	place-items: center;
	width: 2.75rem;
	height: 2.75rem;
	border: 0;
	border-radius: 999px;
	background-color: oklch(1 0 0 / 0.12);
	color: oklch(0.98 0 0);
	font-size: 1.5rem;
	line-height: 1;
	cursor: pointer;
}
.screenshot-close:hover {
	background-color: oklch(1 0 0 / 0.2);
}
.screenshot-close:focus-visible {
	outline: 2px solid oklch(0.98 0 0);
	outline-offset: 2px;
}
</style>
