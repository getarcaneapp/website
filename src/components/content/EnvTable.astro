---
import { envConfig } from '../../lib/config/pages/runtime-config';

const rowId = (name: string) => `var-${name.toLowerCase()}`;
---

<div class="filter-table not-content" data-filter-target="env">
	<table>
		<thead>
			<tr>
				<th>Variable</th>
				<th>Details</th>
			</tr>
		</thead>
		<tbody>
			{envConfig.map((env) => (
				<tr id={rowId(env.name)} data-search={`${env.name} ${env.description}`.toLowerCase()}>
					<td>
						<a class="env-anchor" href={`#${rowId(env.name)}`}>
							<code>{env.name}</code>
						</a>
					</td>
					<td>
						<div class="env-details">
							<p>{env.description}</p>
							{env.deprecated && (
								<div class="env-badges">
									<span class="env-badge deprecated">Deprecated</span>
								</div>
							)}
							<div class="env-meta">
								<span class="env-label">Default</span>
								<code>{env.defaultValue || '—'}</code>
								{env.exampleValue && (
									<>
										<span class="env-label">Example</span>
										<code>{env.exampleValue}</code>
									</>
								)}
							</div>
						</div>
					</td>
				</tr>
			))}
		</tbody>
	</table>
</div>
