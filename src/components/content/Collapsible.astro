---
import { ArrowDownIcon } from '../../lib/icons/index';

interface Props {
	id: string;
	title: string;
	description?: string;
	open?: boolean;
}
const { id, title, description, open = false } = Astro.props;
---

<details class="collapsible" open={open}>
	<summary>
		<ArrowDownIcon class="collapsible-icon" aria-hidden="true" />
		<div class="collapsible-heading">
			<h3 id={id}>{title}</h3>
			{description && <p>{description}</p>}
		</div>
	</summary>
	<div class="collapsible-body">
		<slot />
	</div>
</details>

<style>
/* Full-width disclosure rows: caret, title, divider. No box. */
.collapsible {
	margin: 1.5rem 0 0;
	padding: 0;
	border: 0;
	border-top: 1px solid var(--sl-color-hairline);
	border-bottom: 1px solid var(--sl-color-hairline);
	border-radius: 0;
	background: none;
}
.collapsible + :global(.collapsible) {
	margin-top: 0;
	border-top: 0;
}
.collapsible > summary {
	display: flex;
	align-items: flex-start;
	gap: 0.625rem;
	margin: 0;
	padding: 0.875rem 0;
	cursor: pointer;
	list-style: none;
	user-select: none;
}
.collapsible > summary:focus-visible {
	outline: 2px solid var(--focus-ring);
	outline-offset: 2px;
}
.collapsible[open] > summary {
	margin: 0;
}
.collapsible > summary::before {
	content: none;
}
.collapsible > summary::-webkit-details-marker {
	display: none;
}
.collapsible-heading {
	flex: 1;
	min-width: 0;
}
/* Starlight's `.sl-markdown-content * + *` rule adds margin-top to the heading (it follows the caret).
   Astro scopes with :where(), so this needs the full parent chain to win. */
.collapsible > summary > .collapsible-heading {
	margin-top: 0;
}
.collapsible-heading h3 {
	margin: 0;
	padding: 0;
	border: 0;
	font-size: 1rem;
	font-weight: 600;
	line-height: 1.4;
	letter-spacing: -0.01em;
	color: var(--sl-color-white);
	scroll-margin-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + 1.5rem);
}
.collapsible > summary:hover .collapsible-heading h3 {
	color: var(--sl-color-accent);
}
:global([data-theme="dark"]) .collapsible > summary:hover .collapsible-heading h3 {
	color: var(--sl-color-accent-high);
}
.collapsible-heading p {
	margin: 0.25rem 0 0;
	font-size: var(--sl-text-sm);
	font-weight: 400;
	line-height: 1.5;
	color: var(--sl-color-gray-3);
}
.collapsible :global(.collapsible-icon) {
	width: 1.125rem;
	height: 1.125rem;
	margin-top: 0.125rem;
	flex-shrink: 0;
	color: var(--sl-color-gray-3);
	transform: rotate(-90deg);
	transition: transform 0.2s ease;
}
.collapsible[open] :global(.collapsible-icon) {
	transform: rotate(0deg);
}
@media (prefers-reduced-motion: reduce) {
	.collapsible :global(.collapsible-icon) {
		transition: none;
	}
}
/* Indent content to line up with the title, past the caret. */
.collapsible-body {
	padding: 0 0 1.25rem 1.75rem;
}
.collapsible-body > :global(:first-child) {
	margin-top: 0;
}
</style>
