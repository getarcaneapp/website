---
import { RssIcon } from '../../lib/icons/index';
---

<a class="rss-link" href="/rss.xml">
	<RssIcon />
	RSS
</a>

<style>
.rss-link {
	display: inline-flex;
	align-items: center;
	gap: 0.375rem;
	height: 2rem;
	padding: 0 0.875rem;
	border-radius: 999px;
	background-color: var(--button);
	color: var(--button-foreground);
	font-size: var(--sl-text-sm);
	font-weight: 600;
	text-decoration: none;
}
.rss-link:hover {
	background-color: var(--button-hover);
}
.rss-link:focus-visible {
	outline: 2px solid var(--focus-ring);
	outline-offset: 2px;
}
.rss-link :global(svg) {
	width: 0.875rem;
	height: 0.875rem;
}
</style>
