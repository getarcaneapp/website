---
import { featuredCommunityItems } from '../../lib/config/community';
import { ArrowRightIcon } from '../../lib/icons/index';
import { button } from '../landing/button';
import CommunityGrid from './CommunityGrid.astro';
---

{featuredCommunityItems.length > 0 && (
	<section class="relative pb-20">
		<div class="mb-10 flex flex-col items-center gap-2 text-center">
			<h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Made by the community</h2>
			<p class="mt-2 max-w-xl text-sm text-muted-foreground">
				Tutorials, reviews, and write-ups from people using Arcane.
			</p>
		</div>
		<CommunityGrid items={featuredCommunityItems} />
		<div class="mt-10 flex justify-center">
			<a href="/community" class:list={[button.outline, 'group']}>
				Explore the community
				<ArrowRightIcon class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
			</a>
		</div>
	</section>
)}
