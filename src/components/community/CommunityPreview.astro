---
import { featuredCommunityItems } from '../../lib/config/community';
import { ArrowRightIcon } from '../../lib/icons/index';
import CommunityGrid from './CommunityGrid.astro';
---

{featuredCommunityItems.length > 0 && (
	<section class="border-t border-border py-16" aria-labelledby="community-preview-title">
		<h2
			id="community-preview-title"
			class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl"
		>
			Made by the community
		</h2>
		<p class="mt-2 text-muted-foreground">
			Tutorials, reviews, and write-ups from people using Arcane.
		</p>
		<div class="mt-8">
			<CommunityGrid items={featuredCommunityItems} />
		</div>
		<a
			href="/community"
			class="mt-6 inline-flex items-center gap-1.5 rounded-sm text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			See all videos and articles
			<ArrowRightIcon class="size-4" aria-hidden="true" />
		</a>
	</section>
)}
