---
import { Image } from 'astro:assets';
import { NewsIcon } from '../../lib/icons/index';
import type { CommunityItem } from '../../lib/types/community.type';
import VideoEmbed from './VideoEmbed.astro';

interface Props {
	item: CommunityItem;
}
const { item } = Astro.props;

// Remote thumbnails need their size fetched at build time; imported assets already carry it.
const thumbnail =
	item.kind === 'article' &&
	(typeof item.thumbnail === 'string'
		? { src: item.thumbnail, inferSize: true as const }
		: item.thumbnail && { src: item.thumbnail });

const formatDate = (isoDate: string) => {
	const date = new Date(`${isoDate}T00:00:00Z`);
	if (Number.isNaN(date.getTime())) return isoDate;
	return date.toLocaleDateString('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC'
	});
};

const meta = [
	item.kind === 'video' ? 'Video' : 'Article',
	item.author,
	item.kind === 'article' ? item.source : undefined
].filter(Boolean);
---

<article class="grid grid-cols-1 gap-4 py-6 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-6">
	<div>
		{item.kind === 'video' ? (
			<VideoEmbed videoId={item.videoId} title={item.title} thumbnail={item.thumbnail} />
		) : (
			<div class="aspect-video w-full overflow-hidden rounded-md bg-muted">
				{thumbnail ? (
					<Image
						{...thumbnail}
						alt=""
						widths={[448, 896]}
						sizes="(min-width: 40rem) 14rem, 100vw"
						class="h-full w-full object-cover"
						loading="lazy"
					/>
				) : (
					<span class="flex h-full w-full items-center justify-center">
						<NewsIcon class="size-8 text-muted-foreground" />
					</span>
				)}
			</div>
		)}
	</div>
	<div class="flex min-w-0 flex-col gap-1.5">
		<h3 class="text-base leading-snug font-medium text-foreground">
			<a
				href={item.url}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-sm underline-offset-4 hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				{item.title}<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</h3>
		<p class="text-sm text-muted-foreground">
			{meta.join(' · ')}{' · '}<time datetime={item.publishedAt}
				>{formatDate(item.publishedAt)}</time
			>
		</p>
		{item.description && <p class="text-sm text-muted-foreground">{item.description}</p>}
	</div>
</article>
