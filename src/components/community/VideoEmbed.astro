---
import { Image } from 'astro:assets';
import { PlayIcon } from '../../lib/icons/index';

interface Props {
	videoId: string;
	title: string;
	thumbnail?: string;
}
const { videoId, title, thumbnail } = Astro.props;
const poster = thumbnail ?? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="relative aspect-video w-full overflow-hidden rounded-md bg-muted" data-video-embed>
	<button
		type="button"
		class="group/play absolute inset-0 h-full w-full cursor-pointer rounded-md focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
		aria-label={`Play video: ${title}`}
		data-video-id={videoId}
		data-video-title={title}
	>
		<Image
			src={poster}
			alt=""
			inferSize
			widths={[448, 896]}
			sizes="(min-width: 40rem) 14rem, 100vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
		<span
			class="absolute inset-0 m-auto flex size-11 items-center justify-center rounded-full bg-black/70 transition-colors group-hover/play:bg-black/85 motion-reduce:transition-none"
		>
			<PlayIcon class="size-5 translate-x-0.5 text-white" />
		</span>
	</button>
</div>

<script>
document
	.querySelectorAll<HTMLButtonElement>('[data-video-embed] button[data-video-id]')
	.forEach((button) => {
		button.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.className = 'absolute inset-0 h-full w-full';
			iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?autoplay=1&rel=0`;
			iframe.title = `YouTube: ${button.dataset.videoTitle}`;
			iframe.allowFullscreen = true;
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			button.replaceWith(iframe);
			iframe.focus();
		});
	});
</script>
