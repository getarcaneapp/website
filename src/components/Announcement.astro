---
import { getFeaturedPost } from '../lib/blog';
import { ArrowRightIcon, CloseIcon } from '../lib/icons/index';

const featured = await getFeaturedPost();
---

{featured && (
	<div
		class="relative flex items-center justify-center border-b border-border bg-surface-muted px-12 py-2"
		data-announcement={featured.slug}
		data-pagefind-ignore
	>
		<a
			href={featured.href}
			class="inline-flex min-w-0 items-center gap-2 text-xs font-medium text-foreground transition-colors hover:text-primary"
		>
			<span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
			<span class="truncate">{featured.data.banner ?? featured.data.title}</span>
			<ArrowRightIcon class="size-3 shrink-0 text-muted-foreground" />
		</a>
		<button
			type="button"
			class="absolute top-1/2 right-3 grid size-7 -translate-y-1/2 place-items-center rounded-md text-muted-foreground transition-colors after:absolute after:-inset-2 after:content-[''] hover:bg-accent hover:text-foreground"
			aria-label="Dismiss announcement"
			data-announcement-dismiss
		>
			<CloseIcon class="size-3.5" />
		</button>
	</div>
)}

<script is:inline>
(() => {
	document.querySelectorAll('[data-announcement]').forEach((el) => {
		const key = `arcane:dismissed-announcement:${el.dataset.announcement}`;
		if (localStorage.getItem(key) === '1') {
			el.remove();
			return;
		}
		el.querySelector('[data-announcement-dismiss]')?.addEventListener('click', () => {
			localStorage.setItem(key, '1');
			el.remove();
		});
	});
})();
</script>
