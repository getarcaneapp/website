---
import '../styles/landing.css';
import { Code } from 'astro:components';
import Announcement from '../components/Announcement.astro';
import CommunityPreview from '../components/community/CommunityPreview.astro';
import RedditComments from '../components/community/RedditComments.astro';
import { button } from '../components/landing/button';
import Header from '../components/landing/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Heartbeat from '../lib/components/heartbeat.svelte';
import LogoFull from '../lib/components/logo-full.svelte';
import { DEMO_URL } from '../lib/config/docs';
import { features } from '../lib/config/features';
import {
	AndroidBrandIcon,
	AppleBrandIcon,
	ArrowRightIcon,
	CheckIcon,
	CopyIcon,
	ExternalLinkIcon
} from '../lib/icons/index';
import { MANAGER_IMAGES } from '../lib/utils/instance-generator';
import { PLAUSIBLE_INIT, PLAUSIBLE_SRC, sharedHead } from '../sharedHead';

const title = 'Arcane - Modern Docker Management, Designed for Everyone';
const description =
	'Arcane is a free, open-source Docker management UI for containers, images, volumes, networks, Compose projects, and remote hosts.';
// biome-ignore lint/style/noNonNullAssertion: `site` is always set in astro.config.mjs
const site = Astro.site!;
const canonical = new URL('/', site).href;
const head = sharedHead(site).filter((tag) => tag.tag !== 'script');

const composeFile = (image: string) => `services:
  arcane:
    image: ${image}
    container_name: arcane
    ports:
      - '3552:3552'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - arcane-data:/app/data
    environment:
      - ARCANE_ENCRYPTION_KEY=your-32-char-encryption-key
      - TZ=UTC
    cgroup: host
    restart: unless-stopped

volumes:
  arcane-data:`;
const images = Object.values(MANAGER_IMAGES);

const focusRing =
	'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const sectionTitle = 'text-2xl font-semibold tracking-tight text-foreground md:text-3xl';

const MOBILE_BETA_URL = '/docs/settings/mobile-app';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title}</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={canonical}>
		<link rel="icon" href="/img/favicon.ico">
		<link rel="sitemap" href="/sitemap-index.xml">
		<meta property="og:type" content="website">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonical}>
		<meta property="og:site_name" content="Arcane">
		{head.map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
		<script async src={PLAUSIBLE_SRC}></script>
		<script is:inline set:html={PLAUSIBLE_INIT} />
		<script is:inline>
		(() => {
			let stored = null;
			try {
				stored = localStorage.getItem('starlight-theme');
			} catch {}
			const theme =
				stored === 'light' || stored === 'dark'
					? stored
					: matchMedia('(prefers-color-scheme: light)').matches
						? 'light'
						: 'dark';
			document.documentElement.dataset.theme = theme;
		})();
		</script>
	</head>
	<body class="overflow-x-clip overscroll-none">
		<Announcement />
		<Header />
		<main class="mx-auto w-full max-w-screen-2xl px-4 lg:px-6">
			<section
				class="grid grid-cols-1 items-center gap-10 pt-12 pb-20 md:pt-16 lg:grid-cols-2 lg:gap-16"
				aria-labelledby="hero-title"
			>
				<div class="flex flex-col items-start">
					<a
						href={MOBILE_BETA_URL}
						data-track-cta="mobile_beta"
						data-track-placement="home_hero"
						class:list={[
							'mb-6 inline-flex items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline',
							focusRing
						]}
					>
						<span class="inline-flex items-center gap-1" aria-hidden="true">
							<AppleBrandIcon class="size-3.5" />
							<AndroidBrandIcon class="size-3.5" />
						</span>
						Join the Arcane Mobile beta for iOS and Android
						<ArrowRightIcon class="size-4" aria-hidden="true" />
					</a>

					<LogoFull class="mb-8 h-16 w-auto sm:h-20 lg:h-24" />

					<h1
						id="hero-title"
						class="text-3xl font-semibold tracking-tighter text-foreground sm:text-4xl lg:text-[clamp(2rem,3.2vw,3rem)]"
					>
						<span class="sm:whitespace-nowrap">Modern Docker management,</span>
						<br>
						<span class="text-primary">designed for everyone.</span>
					</h1>

					<div class="mt-8 flex flex-wrap items-center gap-3">
						<a
							href="/docs/get-started/installation"
							class={button.primaryLg}
							data-track-cta="get_started"
							data-track-placement="home_hero"
						>
							Get Started
							<ArrowRightIcon class="size-4" aria-hidden="true" />
						</a>
						<a
							href={DEMO_URL}
							target="_blank"
							class={button.outlineLg}
							data-track-cta="demo"
							data-track-placement="home_hero"
						>
							Try the demo
							<ExternalLinkIcon class="size-4" aria-hidden="true" />
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					</div>
					<p class="mt-5 text-sm font-medium tracking-wide text-primary">
						Always free. Forever. Never changing.
					</p>
				</div>

				<div class="relative mx-auto w-full max-w-2xl lg:max-w-none">
					<div
						class="pointer-events-none absolute -inset-4 rounded-2xl glow-center opacity-40 light:opacity-60"
						aria-hidden="true"
					></div>
					<section
						class="relative overflow-hidden rounded-xl border border-primary/20 bg-code shadow-lg shadow-primary/5 [&_.line:nth-child(3)]:bg-primary/14 [&_.line:nth-child(3)_span]:transition-opacity [&_.line:nth-child(3)_span]:duration-280 data-swapping:[&_.line:nth-child(3)_span]:opacity-0 motion-reduce:[&_.line:nth-child(3)_span]:transition-none"
						aria-label="Docker Compose example"
						data-compose-preview
					>
						<div class="flex items-center gap-3 border-b border-primary/10 bg-surface/80 px-5 py-3">
							<div class="flex items-center gap-1.5">
								<span class="size-2.5 rounded-full bg-destructive/80"></span>
								<span class="size-2.5 rounded-full bg-warning/80"></span>
								<span class="size-2.5 rounded-full bg-success/80"></span>
							</div>
							<span class="font-mono text-xs text-muted-foreground">compose.yaml</span>
							<button
								type="button"
								class="extend-touch-target ml-auto grid size-7 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
								aria-label="Copy compose.yaml"
								data-compose-copy
							>
								<CopyIcon class="size-4" data-copy-icon />
								<CheckIcon class="hidden size-4" data-copied-icon />
							</button>
						</div>
						{images.map((image, index) => (
							<div data-compose-variant hidden={index > 0} data-code={composeFile(image)}>
								<Code
									code={composeFile(image)}
									lang="yaml"
									themes={{ light: 'github-light-default', dark: 'github-dark-default' }}
									defaultColor={false}
								/>
							</div>
						))}
					</section>
				</div>
			</section>

			<!-- Full-bleed like the original layout, so the marquee fades out at the viewport edges. -->
			<div class="relative ml-[calc(50%-50vw)] w-screen">
				<RedditComments />
			</div>

			<section class="border-t border-border py-16" aria-labelledby="features-title">
				<h2 id="features-title" class={sectionTitle}>Everything you need to manage Docker</h2>
				<ul class="mt-8 grid grid-cols-1 gap-x-12 md:grid-cols-2">
					{features.map((feature) => (
						<li class="flex gap-3 border-b border-border py-4">
							<feature.icon class="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
							<div>
								<h3 class="text-base font-medium text-foreground">{feature.title}</h3>
								<p class="mt-0.5 text-sm text-muted-foreground">{feature.description}</p>
							</div>
						</li>
					))}
				</ul>
			</section>

			<CommunityPreview />

			<section class="border-t border-border py-16" aria-labelledby="heartbeat-title">
				<Heartbeat client:visible />
			</section>
		</main>
		<div class="mx-auto w-full max-w-screen-2xl px-4 lg:px-6">
			<SiteFooter />
		</div>
		<SiteScripts />

		<script>
		const preview = document.querySelector<HTMLElement>('[data-compose-preview]');
		if (preview) {
			const variants = [...preview.querySelectorAll<HTMLElement>('[data-compose-variant]')];
			let index = 0;
			let hovered = false;
			let fadeTimer: ReturnType<typeof setTimeout> | undefined;
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const holdMs = reduceMotion ? 5000 : 3200;
			const fadeMs = reduceMotion ? 0 : 280;

			const show = (next: number) => {
				variants.forEach((variant, i) => {
					variant.hidden = i !== next;
				});
				index = next;
			};

			preview.addEventListener('mouseenter', () => {
				hovered = true;
				if (fadeTimer) clearTimeout(fadeTimer);
				delete preview.dataset.swapping;
			});
			preview.addEventListener('mouseleave', () => (hovered = false));

			if (variants.length > 1) {
				setInterval(() => {
					if (hovered) return;
					if (fadeMs === 0) return show((index + 1) % variants.length);
					preview.dataset.swapping = '';
					fadeTimer = setTimeout(() => {
						if (!hovered) show((index + 1) % variants.length);
						requestAnimationFrame(() =>
							requestAnimationFrame(() => delete preview.dataset.swapping)
						);
					}, fadeMs);
				}, holdMs);
			}

			const copyButton = preview.querySelector<HTMLButtonElement>('[data-compose-copy]');
			copyButton?.addEventListener('click', async () => {
				await navigator.clipboard.writeText(variants[index]?.dataset.code ?? '');
				copyButton.querySelector('[data-copy-icon]')?.classList.add('hidden');
				copyButton.querySelector('[data-copied-icon]')?.classList.remove('hidden');
				setTimeout(() => {
					copyButton.querySelector('[data-copy-icon]')?.classList.remove('hidden');
					copyButton.querySelector('[data-copied-icon]')?.classList.add('hidden');
				}, 1500);
			});
		}
		</script>
	</body>
</html>
