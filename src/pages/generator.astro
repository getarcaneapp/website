---
import WidePage from '../components/pages/WidePage.astro';
import InstanceGenerator from '../lib/components/instance-generator.svelte';
---

<WidePage
	title="Instance Generator"
	description="Pick a deployment, set your options, and copy the Compose file, Quadlet, or agent config Arcane needs."
>
	<div class="arcane-ui not-content">
		<p class="max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
			Choose where Arcane runs, fill in the fields, then copy or download the files. See the{' '}
			<a
				href="/docs/get-started/installation"
				class="rounded-sm font-medium text-primary underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring dark:text-primary-tint"
				>installation guide</a
			>{' '}
			or the{' '}
			<a
				href="/docs/reference/environment-variables"
				class="rounded-sm font-medium text-primary underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring dark:text-primary-tint"
				>environment variables</a
			>.
		</p>
		<div id="configure" class="mt-6">
			<InstanceGenerator client:load />
		</div>
	</div>
</WidePage>
