---
import { button } from '../components/landing/button';
import WidePage from '../components/pages/WidePage.astro';
import DockerComposeGenerator from '../lib/components/docker-compose-generator.svelte';
import { BookOpenIcon, SettingsIcon } from '../lib/icons/index';
---

<WidePage
	title="Docker Compose Generator"
	description="Follow the guided steps to configure Arcane services, credentials, and storage. Your Compose file is updated in real time."
>
	<div class="arcane-ui not-content">
		<div class="inline-flex w-full flex-wrap gap-2.5 sm:w-auto">
			<a href="/docs/get-started/installation" class:list={[button.outlineSm, 'group']}>
				<BookOpenIcon class="h-4 w-4 transition-transform duration-300 group-hover:scale-110" />
				Setup Guide
			</a>
			<a href="/docs/reference/environment-variables" class:list={[button.outlineSm, 'group']}>
				<SettingsIcon class="h-4 w-4 transition-transform duration-300 group-hover:rotate-90" />
				Environment Docs
			</a>
		</div>
		<section id="configure" class="mt-8">
			<DockerComposeGenerator client:load />
		</section>
	</div>
</WidePage>
