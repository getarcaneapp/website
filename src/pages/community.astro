---
import CommunityGrid from '../components/community/CommunityGrid.astro';
import WidePage from '../components/pages/WidePage.astro';
import { communityArticles, communityVideos } from '../lib/config/community';
import { DISCORD_URL } from '../lib/config/docs';

const heading = 'mb-4 text-lg font-semibold tracking-tight text-foreground';
const link =
	'rounded-sm text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<WidePage
	title="Community"
	description="Videos, articles, and blog posts about Arcane, made by the people who use it."
>
	<div class="arcane-ui not-content">
		<section class="pb-14" aria-labelledby="community-videos">
			<h2 id="community-videos" class={heading}>Videos</h2>
			<CommunityGrid items={communityVideos} emptyMessage="No videos yet. Check back soon." />
		</section>

		<section class="pb-14" aria-labelledby="community-articles">
			<h2 id="community-articles" class={heading}>Articles and blog posts</h2>
			<CommunityGrid items={communityArticles} emptyMessage="No articles yet. Check back soon." />
		</section>

		<section class="pb-8" aria-labelledby="community-share">
			<h2 id="community-share" class={heading}>Share your work</h2>
			<p class="max-w-prose text-sm text-muted-foreground">
				Share your video or article on{' '}
				<a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class={link}
					>Discord<span class="sr-only"> (opens in a new tab)</span></a
				>{' '}
				or email{' '}
				<a href="mailto:info@getarcane.app" class={link}>info@getarcane.app</a>.
			</p>
		</section>
	</div>
</WidePage>
