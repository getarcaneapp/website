---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import KindBadge from '../../components/blog/KindBadge.astro';
import RssLink from '../../components/blog/RssLink.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<StarlightPage
	frontmatter={{
		title: 'Blog',
		description: 'A home for deprecations, migrations, and other notable changes.',
		template: 'splash',
		editUrl: false
	}}
>
	<div class="blog-head not-content">
		<RssLink />
	</div>
	{posts.length === 0 ? (
		<p>No posts yet.</p>
	) : (
		<ol class="blog-list not-content">
			{posts.map((post) => (
				<li>
					<a href={post.href}>
						<time datetime={post.dateYmd}>{post.dateLabel}</time>
						<div>
							<KindBadge kind={post.data.kind} />
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</div>
					</a>
				</li>
			))}
		</ol>
	)}
</StarlightPage>

<style>
	.blog-head {
		display: flex;
		justify-content: flex-end;
	}
	.blog-list {
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		border-block: 1px solid var(--sl-color-hairline);
	}
	.blog-list li + li {
		border-top: 1px solid var(--sl-color-hairline);
	}
	.blog-list a {
		display: grid;
		gap: 0.75rem;
		padding: 2rem 0;
		color: inherit;
		text-decoration: none;
	}
	@media (min-width: 40rem) {
		.blog-list a {
			grid-template-columns: 11rem minmax(0, 1fr);
			gap: 2rem;
		}
	}
	.blog-list time {
		padding-top: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.blog-list h2 {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
		transition: color 0.15s ease;
	}
	.blog-list a:hover h2 {
		color: var(--sl-color-accent-high);
	}
	:global([data-theme='light']) .blog-list a:hover h2 {
		color: var(--sl-color-accent);
	}
	.blog-list p {
		margin: 0.5rem 0 0;
		max-width: 36rem;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
</style>
